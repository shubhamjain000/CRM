  createdAt       DateTime @default(now())

  emails          Email[]

  @@index([organizationId, lastActivityAt])
  @@index([organizationId, relatedModule, relatedId])
}

model Email {
  id              String   @id @default(cuid())
  organizationId  String
  accountId       String?
  account         EmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  threadId        String?
  thread          EmailThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  messageId       String?
  fromAddress     String
  toAddresses     String   @default("[]") // JSON array
  cc              String   @default("[]") // JSON array
  bcc             String   @default("[]") // JSON array
  subject         String
  bodyHtml        String   @default("")
  bodyText        String   @default("")
  attachments     String   @default("[]") // JSON array
  direction       String   @default("outbound") // inbound|outbound
  status          String   @default("draft") // draft|queued|sent|delivered|bounced|opened|clicked|spam
  relatedModule   String?
  relatedId       String?
  isStarred       Boolean  @default(false)
  isImportant     Boolean  @default(false)
  hasAttachments  Boolean  @default(false)
