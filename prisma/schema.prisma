model EmailAccount {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  provider        String   @default("gmail") // gmail|outlook|imap|exchange|yahoo|custom
  emailAddress    String
  credentials     String   @default("{}") // JSON (encrypted in prod)
  authMode        String? // oauth | app-password — connection strategy for this mailbox
  syncEnabled     Boolean  @default(true)
  syncFrequency   Int      @default(2) // minutes
  lastSyncedAt    DateTime?
  lastSyncError   String? // last sync failure message (null = healthy)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  emails          Email[]

  @@index([organizationId, userId, isActive])
}

model EmailThread {
  id              String   @id @default(cuid())
  organizationId  String
  subject         String
  relatedModule   String?
  relatedId       String?
  lastActivityAt  DateTime @default(now())
  emailCount      Int      @default(0)
