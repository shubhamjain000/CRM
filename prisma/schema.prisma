// Foundation — Phase 2: Enterprise Auth & Multi-tenancy
// Prisma schema (SQLite in sandbox; mirrors the Django models for the live app).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth: custom email-based user
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String?
  totpSecret        String?
  is2faEnabled      Boolean  @default(false)
  isSuperuser       Boolean  @default(false)
  passwordChangedAt DateTime @default(now())
  lastLoginAt       DateTime?
  lastLoginIp       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships       TenantMembership[]
  profile           Profile?
  loginHistory      LoginHistory[]
  devices           Device[]
  apiKeys           ApiKey[]
  webauthnCredentials WebAuthnCredential[]
  passwordHistory   PasswordHistory[]
  auditLogsActor    AuditLog[]    @relation("AuditActor")
  magicLinks        MagicLink[]
  passkeyChallenges PasskeyChallenge[]
  sessions          Session[]
  campaigns         Campaign[]    @relation("CampaignOwner")
  products          Product[]     @relation("ProductOwner")
  priceBooks        PriceBook[]   @relation("PriceBookOwner")
  vendors           Vendor[]      @relation("VendorOwner")
  quotes            Quote[]       @relation("QuoteOwner")
  salesOrders       SalesOrder[]  @relation("SalesOrderOwner")
  purchaseOrders    PurchaseOrder[] @relation("PurchaseOrderOwner")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl String?
  phone     String?
  timezone  String   @default("UTC")
  locale    String   @default("en")
  preferences String  @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Multi-tenancy: organizations, memberships, roles, teams
// ---------------------------------------------------------------------------

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  subdomain     String   @unique
  customDomain  String?  @unique
  isActive      Boolean  @default(true)
  ipAllowlist   String   @default("[]") // JSON array of CIDRs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   TenantMembership[]
  roles         Role[]
  teams         Team[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  loginHistory  LoginHistory[]
}

model TenantMembership {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String
  roleId          String
  isActive        Boolean  @default(true)
  joinedAt        DateTime @default(now())
  currentOrg      Boolean  @default(false) // user's last-active org

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Role {
  id              String   @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  permissions     String   @default("[]") // JSON array of permission strings
  parentId        String?  // role hierarchy inheritance
  parent          Role?    @relation("RoleHierarchy", fields: [parentId], references: [id])
  children        Role[]   @relation("RoleHierarchy")
  isSystem        Boolean  @default(false)
  createdAt       DateTime @default(now())

  memberships     TenantMembership[]
  fieldSecurity   FieldSecurity[]

  @@index([organizationId])
}

model Team {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  parentId        String?
  parent          Team?    @relation("TeamHierarchy", fields: [parentId], references: [id])
  children        Team[]   @relation("TeamHierarchy")
  leadId          String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model FieldSecurity {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  model     String
  field     String
  level     String   // "visible" | "read_only" | "hidden"
  createdAt DateTime @default(now())

  @@unique([roleId, model, field])
}

// ---------------------------------------------------------------------------
// Auth: sessions, devices, login history, API keys, credentials
// ---------------------------------------------------------------------------

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String   @unique
  name            String?
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  expiresAt       DateTime

  @@index([userId])
}

model Device {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  ip              String?
  userAgent       String?
  platform        String?  // ios, android, web
  pushToken       String?
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId])
}

model LoginHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ip              String?
  userAgent       String?
  success         Boolean
  method          String   // password | passkey | oauth | saml | magic-link | 2fa
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

model ApiKey {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name            String
  keyHash         String   @unique
  keyPrefix       String
  scopes          String   @default("[]") // JSON
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

model WebAuthnCredential {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId    String   @unique // base64url
  publicKey       String   // base64url
  counter         Int      @default(0)
  transports      String   @default("[]") // JSON
  name            String   @default("Passkey")
  createdAt       DateTime @default(now())

  @@index([userId])
}

model PasskeyChallenge {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge       String
  type            String   // "registration" | "authentication"
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model MagicLink {
  id              String   @id @default(cuid())
  email           String
  tokenHash       String   @unique
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([email])
}

// ---------------------------------------------------------------------------
// Audit log — every auth/event
// ---------------------------------------------------------------------------

model AuditLog {
  id              String   @id @default(cuid())
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId         String?
  actor           User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action          String   // e.g. user.login, user.invite, role.create
  targetType      String?
  targetId        String?
  ip              String?
  userAgent       String?
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Login throttling (django-axes style)
// ---------------------------------------------------------------------------

model LoginAttempt {
  id              String   @id @default(cuid())
  ip              String
  email           String?
  success         Boolean
  createdAt       DateTime @default(now())

  @@index([ip, createdAt])
  @@index([email, createdAt])
}

// ===========================================================================
// Phase 3 — CRM: Pipelines, Stages, Accounts, Contacts, Leads, Deals
// All tenant-scoped (organizationId) + soft-delete (deletedAt) + composite
// indexes mirroring the Django backend.
// ===========================================================================

model Pipeline {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  modules         String   @default("[]") // JSON array
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stages          Stage[]
  deals           Deal[]
  transitions     StageTransition[]
  blueprints      Blueprint[]

  @@index([organizationId])
}

model Stage {
  id              String   @id @default(cuid())
  organizationId  String
  pipelineId      String
  pipeline        Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name            String
  probability     Float    @default(0)
  order           Int      @default(0)
  isWonStage      Boolean  @default(false)
  isLostStage     Boolean  @default(false)
  isClosed        Boolean  @default(false)
  isLocked        Boolean  @default(false) // can't drag back from won/lost
  businessDaysLimit Int?   // alert if stuck
  color           String   @default("#3b82f6")
  icon            String?
  forecastCategory String  @default("pipeline") // pipeline|best_case|commit|closed|omitted
  createdAt       DateTime @default(now())

  deals           Deal[]
  transitionsFrom StageTransition[] @relation("TransitionFrom")
  transitionsTo   StageTransition[] @relation("TransitionTo")
  historyFrom     DealStageHistory[] @relation("HistoryFrom")
  historyTo       DealStageHistory[] @relation("HistoryTo")
  blueprintStates BlueprintState[]

  @@index([organizationId, pipelineId])
}

model Account {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  accountNumber   String?
  accountType     String   @default("prospect") // customer|prospect|partner|competitor|vendor
  industry        String?
  annualRevenue   Float?
  employees       Int?
  website         String?
  billingAddress  String   @default("{}")
  shippingAddress String   @default("{}")
  parentAccountId String?
  parentAccount   Account? @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  children        Account[] @relation("AccountHierarchy")
  tickerSymbol    String?
  ownership       String?
  rating          String?
  sicCode         String?
  isSeed          Boolean  @default(false)
  ownerId         String
  tags            String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  contacts        Contact[]
  deals           Deal[]
  convertedLeads  Lead[]
  listings        ContactListing[]
  pocContactId    String?
  pocContact      Contact? @relation("AccountPoc", fields: [pocContactId], references: [id], onDelete: SetNull)

  @@index([organizationId, deletedAt])
  @@index([organizationId, ownerId])
  @@index([organizationId, accountType])
  @@index([organizationId, parentAccountId])
}

model Contact {
  id              String   @id @default(cuid())
  organizationId  String
  firstName       String
  lastName        String
  accountId       String?
  account         Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  title           String?
  emails          String   @default("[]") // JSON array
  phones          String   @default("[]") // JSON array
  addresses       String   @default("[]") // JSON array
  socialProfiles  String   @default("{}") // JSON
  birthday        DateTime?
  department      String?
  assistant       String?
  leadSource      String?
  description     String? // free-form notes (import wizard Description column)
  ownerId         String
  doNotCall       Boolean  @default(false)
  emailOptOut     Boolean  @default(false)

  // Unstop Sales CSM cadence — next touchpoint in the follow-up loop.
  // csmNextStep is one of the canonical labels in src/lib/csm.ts;
  // At/DueAt are maintained server-side (never accepted from clients).
  csmNextStep      String    @default("None")
  csmNextStepAt    DateTime? // when the current step was set
  csmNextStepDueAt DateTime? // follow-up due (set date + step offset)

  // Listing Intelligence (additive) — mirrors the daily listing CSV columns.
  // All optional (NULL default) so no existing save flow can break.
  recruiterTag         String?    // New Recruiter | Existing Recruiter (CSV recruiter_tag)
  premiumStatus        String?    // Free | Paid (CSV premium)
  listingSubtype       String?    // Jobs | Internships (CSV subtype)
  totalApplications    Int?       // CSV applications
  reasonableFitPct     Float?     // 0–100 (CSV reasonable_fit_%)
  reasonableScoreUsers Int?       // CSV reasonable_score_users
  listingUrl           String?    // clickable listing link (CSV listing_link)
  listingTitle         String?    // CSV listing_title
  listingCategory      String?    // JSON array of category labels (CSV category)
  dateApproved         DateTime?  // CSV date_approved
  visibility           String?    // mirror of latest listing: Public | Private
  hiringStatus         String?    // mirror of latest listing: Open | In Review | Filled | Closed
  relevantApplications Int?       // mirror of latest listing: applications ≥34% match
  hiredCount           Int?       // mirror of latest listing: hires closed

  // CSM automation fields referenced by workflow conditions/actions and
  // assignment-rule criteria (additive, optional — maintained by automations).
  csmRecruiterType     String?    // First Time | Existing | New
  csmStatus            String?    // free-form CSM status label
  csmNextCallDate      DateTime?  // next scheduled call date
  totalReachoutsDone   Int?       // incremented by reachout automations
  lastReachedOutAt     DateTime?  // stamped when a reachout is logged/sent

  // Zoho "Recruiter Information" form (additive, optional — mirrors the
  // recruiter form sections: Form Details / Reachout TAT & CSM Status /
  // Paid Plan Pitch & Details / Additional Recruiter Details).
  typeOfLead           String?    // Type of Lead (CSM | Organic | Inbound | Outbound | Other)
  recruiterTriggers    String?    // Recruiter Triggers (free text)
  company              String?    // Form Details: Company
  employeeRange        String?    // Form Details: Employee Range (picklist)
  linkedinUrl          String?    // Form Details: LinkedIn URL
  totalOps             Int?       // Form Details: Total Ops
  modifiedById         String?    // Form Details: Modified By (stamped server-side on PATCH)
  reachoutTat          String?    // Reachout TAT (e.g. "Same day", "24 hours")
  firstConversationAt  DateTime?  // First Conversation Call (date)
  totalConversationsHad Int?      // Total Conversations Had
  hiringRoles          String?    // "How many & for what roles are you hiring?"
  joiningTimeline      String?    // "How soon you want the candidate to join?" (picklist)
  otherPlatformUsed    String?    // "Have you used any other platform?"
  recruiterFeedback    String?    // Recruiter Feedback (long text)
  paidPlanPitch        String?    // Paid Plan Pitch (long text)
  livePremiumOps       Int?       // No. of Live Premium Ops
  postPitchLeadType    String?    // Post Pitch Lead type (picklist)
  paidPlanPitchDate    DateTime?  // Date of Paid Plan Pitch
  paidPlanFeedback     String?    // Paid Recruiter Subjective Feedback (long text)
  paidPlanExpiryDate   DateTime?  // Paid Plan Expiry Date
  addRecruiterName     String?    // Additional Recruiter Details: Name (Add)
  addRecruiterDesignation String? // Additional Recruiter Details: Designation
  addRecruiterMobile   String?    // Additional Recruiter Details: Mobile Number (Add)

  isSeed          Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  primaryDeals    Deal[]   @relation("DealPrimaryContact")
  dealContacts    DealContact[]
  convertedLeads  Lead[]
  pocForAccounts  Account[] @relation("AccountPoc")
  listings        ContactListing[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, csmNextStepDueAt])
  @@index([organizationId, accountId])
  @@index([organizationId, ownerId])
}

/**
 * Listing history — one recruiter (Contact) accumulates many listings over
 * time. Every import row with a NEW listing link adds one entry here, so the
 * same email can hold 2+ listings across imports (long-term use). The
 * Contact's own listing* columns stay a mirror of the LATEST listing.
 */
model ContactListing {
  id             String   @id @default(cuid())
  organizationId String
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accountId      String?  // company the listing belongs to (grouping key)
  account        Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  url            String?  // listing link — the per-listing identity
  title          String?
  subtype        String?  // Jobs | Internships
  category       String?  // JSON array of category labels
  recruiterTag   String?  // New Recruiter | Existing Recruiter
  premiumStatus  String?  // Free | Paid
  visibility     String?  // Public | Private (CSV column or filled in later by the sales agent)
  hiringStatus   String?  // Open | In Review | Filled | Closed (sales-agent maintained)
  totalApplications     Int?
  relevantApplications  Int?  // applications with a ≥34% match ("Relevant Applications")
  hiredCount            Int?  // hires closed through this listing
  reasonableFitPct      Float?
  reasonableScoreUsers  Int?
  dateApproved   DateTime?
  source         String   @default("import") // import | api | manual
  firstImportedAt DateTime @default(now())
  lastImportedAt  DateTime @default(now())

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, contactId])
  @@index([contactId])
  @@index([organizationId, accountId])
}

model Lead {
  id              String   @id @default(cuid())
  organizationId  String
  firstName       String
  lastName        String
  emails          String   @default("[]") // JSON array
  phones          String   @default("[]") // JSON array
  company         String?
  title           String?
  leadSource      String?
  leadStatus      String   @default("new") // new|contacted|qualified|unqualified|converted
  rating          String? // hot|warm|cold
  industry        String?
  annualRevenue   Float?
  employees       Int?
  website         String?
  billingAddress  String   @default("{}")
  shippingAddress String   @default("{}")
  description     String?
  ownerId         String
  assignedToId    String?
  createdById     String
  lastActivity    DateTime @default(now())
  score           Float    @default(0)
  isConverted     Boolean  @default(false)
  isSeed          Boolean  @default(false)
  convertedAccountId String?
  convertedAccount  Account? @relation(fields: [convertedAccountId], references: [id], onDelete: Restrict)
  convertedContactId String?
  convertedContact  Contact? @relation(fields: [convertedContactId], references: [id], onDelete: Restrict)
  convertedDealId String?
  convertedDeal   Deal?    @relation(fields: [convertedDealId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId, deletedAt])
  @@index([organizationId, leadStatus, ownerId])
  @@index([organizationId, ownerId, createdAt])
  @@index([organizationId, lastActivity])
}

model Deal {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  amount          Float    @default(0)
  currency        String   @default("INR")
  stageId         String
  stage           Stage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  pipelineId      String
  pipeline        Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  closeDate       DateTime?
  probability     Float    @default(0)
  accountId       String?
  account         Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  primaryContactId String?
  primaryContact  Contact? @relation("DealPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  ownerId         String
  leadSource      String?
  type            String   @default("new_business") // new_business|existing_business|renewal
  nextStep        String?
  description     String?
  lostReason      String?
  competitors     String   @default("[]") // JSON array
  forecastCategory String  @default("pipeline") // pipeline|best_case|commit|closed|omitted
  isSeed          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  convertedLeads  Lead[]
  dealContacts    DealContact[]
  stageHistory    DealStageHistory[]
  blueprintExecutions BlueprintExecution[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, pipelineId])
  @@index([organizationId, closeDate])
}

model DealContact {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role            String?
  createdAt       DateTime @default(now())

  @@unique([dealId, contactId])
  @@index([dealId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Custom fields — extensible schema per tenant per module
// ---------------------------------------------------------------------------

model CustomField {
  id              String   @id @default(cuid())
  organizationId  String
  module          String   // lead|contact|account|deal
  label           String
  apiName         String
  fieldType       String   // text|long_text|number|currency|picklist|checkbox|...
  fieldOptions    String   @default("{}") // JSON
  validationRules String   @default("{}") // JSON
  defaultValue    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  values          CustomFieldValue[]

  @@unique([organizationId, module, apiName])
  @@index([organizationId, module])
}

model CustomFieldValue {
  id              String   @id @default(cuid())
  organizationId  String
  fieldId         String
  field           CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  module          String
  recordId        String
  value           String   @default("null") // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fieldId, recordId])
  @@index([organizationId, module, recordId])
}

// ===========================================================================
// Phase 4 — CRM UX: SavedViews, RecentlyViewed, Activity, Notes, Files, Locks
// ===========================================================================

model SavedView {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  module          String   // lead|contact|account|deal
  name            String
  isShared        Boolean  @default(false)
  isDefault       Boolean  @default(false)
  config          String   @default("{}") // JSON: {filters, sort, columns, groupBy}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, userId, name])
  @@index([organizationId, userId, module])
  @@index([organizationId, module, isShared])
}

model RecentlyViewed {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  module          String
  recordId        String
  recordName      String   @default("")
  viewedAt        DateTime @default(now())

  @@unique([organizationId, userId, module, recordId])
  @@index([organizationId, userId, viewedAt])
  @@index([organizationId, userId, module, viewedAt])
}

model Activity {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String?
  module          String
  recordId        String
  recordName      String   @default("")
  action          String   // created|updated|deleted|converted|note_added|file_attached|emailed|called|meeting
  description     String?
  metadata        String   @default("{}") // JSON
  isSeed          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([organizationId, module, recordId, createdAt])
  @@index([organizationId, userId, createdAt])
}

model Note {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  module          String
  recordId        String
  kind            String   @default("general") // general | call-outcome | day-0 | day-1-reconnect | day-3-followup | week-1-checkin | week-2-update | month-1-review | meeting | email | quote-sent | payment-reminder | objection | next-steps
  body            String
  mentions        String   @default("[]") // JSON array of user ids
  hashtags        String   @default("[]") // JSON array
  isSeed          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, module, recordId, createdAt])
}

model FileAttachment {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  module          String
  recordId        String
  filename        String
  fileUrl         String
  fileSize        Int      @default(0)
  mimeType        String   @default("application/octet-stream")
  createdAt       DateTime @default(now())

  @@index([organizationId, module, recordId])
}

model RecordLock {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  module          String
  recordId        String
  lockedAt        DateTime @default(now())
  expiresAt       DateTime

  @@unique([organizationId, module, recordId])
  @@index([organizationId, module, recordId])
}

// ===========================================================================
// Phase 5 — Productivity: Tasks, Events, Calls, Meetings
// ===========================================================================

model Task {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  dueDate         DateTime?
  reminder        DateTime?
  reminderSentAt  DateTime?
  priority        String   @default("medium") // low|medium|high|urgent
  status          String   @default("not_started") // not_started|in_progress|completed|deferred
  assigneeId      String?
  ownerId         String
  createdById     String
  parentTaskId    String?
  parentTask      Task?    @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: NoAction)
  subtasks        Task[]   @relation("TaskSubtasks")
  relatedModule   String?
  relatedId       String?
  recurrence      String?  // RRULE
  timeSpent       Int      @default(0) // seconds
  timerStartedAt  DateTime?
  checklist       String   @default("[]") // JSON: [{text, done}]
  tags            String   @default("[]") // JSON array
  lastActivity    DateTime @default(now())
  isSeed          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId, assigneeId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, ownerId, status])
  @@index([organizationId, lastActivity])
}

model Event {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  start           DateTime
  end             DateTime
  allDay          Boolean  @default(false)
  location        String?
  externalAttendees String  @default("[]") // JSON array of emails
  recurrence      String?  // RRULE
  reminders       String   @default("[]") // JSON: [{offsetMinutes, sent}]
  conferenceUrl   String?
  conferenceProvider String? // google_meet|zoom|teams|none
  relatedModule   String?
  relatedId       String?
  status          String   @default("confirmed") // confirmed|tentative|cancelled
  organizerId     String
  visibility      String   @default("busy") // public|private|busy
  isSeed          Boolean  @default(false)
  meeting         Meeting?
  attendees       EventAttendee[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId, start])
  @@index([organizationId, organizerId])
  @@index([organizationId, status])
}

model EventAttendee {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId          String
  response        String   @default("none") // yes|no|maybe|none
  required        Boolean  @default(true)
  respondedAt     DateTime?

  @@unique([eventId, userId])
  @@index([eventId])
}

model Meeting {
  id              String   @id @default(cuid())
  eventId         String   @unique
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agenda          String?
  actionItems     String   @default("[]") // JSON: [{text, done, assigneeId}]
  followUpTasksCreated Boolean @default(false)
  engagementScore Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Call {
  id              String   @id @default(cuid())
  organizationId  String
  subject         String
  callType        String   @default("outbound") // inbound|outbound|missed
  duration        Int      @default(0) // seconds
  outcome         String   @default("connected") // connected|voicemail|no_answer|busy
  recordingUrl    String?
  transcription   String?
  sentiment       String?  // positive|neutral|negative
  relatedModule   String?
  relatedId       String?
  voipProvider    String?
  voipCallId      String?
  notes           String?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  ownerId         String
  // Call transfer (admin only). transferredFromId = the previous owner at the
  // moment of transfer; transferredToId = the new owner (= ownerId afterwards);
  // transferredAt = when the handoff happened. Nullable + no FK relations to
  // match the existing loose-reference pattern used across the Call model.
  transferredFromId String?
  transferredToId   String?
  transferredAt     DateTime?
  isSeed            Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId, startedAt])
  @@index([organizationId, relatedModule, relatedId])
  @@index([organizationId, transferredToId])
}

// ===========================================================================
// Phase 6 — Content: Notes, Files, Attachments
// ===========================================================================

model Doc {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  body            String   @default("") // HTML or Yjs doc JSON
  bodyType        String   @default("html") // html|yjs|markdown
  isPinned        Boolean  @default(false)
  isPrivate       Boolean  @default(false)
  authorId        String
  lastEditedById  String?
  relatedModule   String?
  relatedId       String?
  mentions        String   @default("[]") // JSON array of user ids
  hashtags        String   @default("[]") // JSON array
  tags            String   @default("[]") // JSON array
  editHistory     String   @default("[]") // JSON array of {userId, timestamp, snapshot}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  comments        DocComment[]
  versions        DocVersion[]

  @@index([organizationId, authorId, createdAt])
  @@index([organizationId, relatedModule, relatedId])
  @@index([organizationId, isPinned])
}

model DocComment {
  id              String   @id @default(cuid())
  docId           String
  doc             Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  userId          String
  selectedText    String?
  body            String
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([docId, createdAt])
}

model DocVersion {
  id              String   @id @default(cuid())
  docId           String
  doc             Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  userId          String
  body            String
  versionNumber   Int
  createdAt       DateTime @default(now())

  @@unique([docId, versionNumber])
  @@index([docId, versionNumber])
}

model File {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  originalName    String
  size            Int      @default(0)
  mimeType        String   @default("application/octet-stream")
  extension       String   @default("")
  storageKey      String
  storageProvider String   @default("local") // local|s3|minio|r2
  version         Int      @default(1)
  uploadedById    String
  relatedModule   String?
  relatedId       String?
  previewUrl      String?
  thumbnailUrl    String?
  isStarred       Boolean  @default(false)
  description     String?
  tags            String   @default("[]") // JSON array
  virusScanStatus String   @default("pending") // pending|clean|infected|skipped
  ocrText         String?
  ocrStatus       String   @default("skipped") // pending|done|failed|skipped
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  versions        FileVersion[]
  attachments     Attachment[]
  shareLinks      ShareLink[]

  @@index([organizationId, uploadedById, createdAt])
  @@index([organizationId, relatedModule, relatedId])
  @@index([organizationId, isStarred])
  @@index([organizationId, virusScanStatus])
  @@index([organizationId, deletedAt, createdAt])
}

model FileVersion {
  id              String   @id @default(cuid())
  fileId          String
  file            File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionNumber   Int
  size            Int
  storageKey      String
  uploadedById    String
  changeSummary   String?
  createdAt       DateTime @default(now())

  @@unique([fileId, versionNumber])
  @@index([fileId, versionNumber])
}

model ShareLink {
  id              String   @id @default(cuid())
  fileId          String
  file            File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  token           String   @unique
  createdById     String
  expiresAt       DateTime?
  passwordHash    String?
  downloadLimit   Int?
  downloadCount   Int      @default(0)
  watermark       Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([fileId])
}

model Attachment {
  id              String   @id @default(cuid())
  organizationId  String
  recordModule    String   // lead|contact|account|deal|task|event|note
  recordId        String
  fileId          String
  file            File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  attachedById    String
  description     String?
  isInline        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([recordModule, recordId, fileId])
  @@index([organizationId, recordModule, recordId])
  @@index([fileId])
}

// ===========================================================================
// Phase 7 — Real-time fabric: Activity Feed, Notifications, Presence
// ===========================================================================

model FeedPost {
  id              String   @id @default(cuid())
  organizationId  String
  authorId        String
  body            String   @default("")
  mentions        String   @default("[]") // JSON array of user ids
  hashtags        String   @default("[]") // JSON array
  attachments     String   @default("[]") // JSON array of file ids
  relatedModule   String?
  relatedId       String?
  isPinned        Boolean  @default(false)
  editedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  comments        FeedComment[]
  reactions       FeedReaction[]

  @@index([organizationId, createdAt])
  @@index([organizationId, relatedModule, relatedId])
  @@index([organizationId, authorId])
  @@index([organizationId, isPinned])
}

model FeedComment {
  id              String   @id @default(cuid())
  organizationId  String
  postId          String
  post            FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId        String
  body            String
  mentions        String   @default("[]") // JSON array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  reactions       FeedReaction[]

  @@index([postId, createdAt])
  @@index([organizationId, authorId])
}

model FeedReaction {
  id              String   @id @default(cuid())
  organizationId  String
  postId          String?
  post            FeedPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId       String?
  comment         FeedComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId          String
  emoji           String   @default("👍")
  createdAt       DateTime @default(now())

  @@unique([userId, postId, emoji])
  @@unique([userId, commentId, emoji])
  @@index([postId])
  @@index([commentId])
}

model Notification {
  id              String   @id @default(cuid())
  organizationId  String
  actorId         String?
  verb            String   // assigned|mentioned|commented|liked|shared|created|updated|approved|uploaded|invited
  targetModule    String?
  targetId        String?
  targetName      String?
  recipientId     String
  readAt          DateTime?
  channel         String   @default("in_app") // in_app|email|push|sms
  data            String   @default("{}") // JSON
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([organizationId, recipientId, readAt])
  @@index([organizationId, recipientId, createdAt])
  @@index([organizationId, createdAt])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  notificationType String  // mention|comment|like|assignment|approval|file_upload|email_received|task_due|event_reminder
  inApp           Boolean  @default(true)
  email           Boolean  @default(true)
  push            Boolean  @default(false)
  sms             Boolean  @default(false)
  digestMode      String   @default("immediate") // immediate|daily|weekly

  @@unique([organizationId, userId, notificationType])
}

model UserPresence {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String   @unique
  status          String   @default("offline") // online|away|busy|dnd|offline
  statusMessage   String?
  lastSeenAt      DateTime @default(now())
  viewingModule   String?
  viewingId       String?
  viewingName     String?
  updatedAt       DateTime @updatedAt

  @@index([organizationId, status])
}

model LiveCursor {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  module          String
  recordId        String
  field           String
  position        Int      @default(0)
  color           String   @default("#3b82f6")
  updatedAt       DateTime @default(now())

  @@unique([userId, module, recordId])
  @@index([module, recordId])
}

// ===========================================================================
// Phase 8 — Pipeline Engine: Stage Transitions, Deal Stage History
// ===========================================================================

model StageTransition {
  id              String   @id @default(cuid())
  organizationId  String
  pipelineId      String
  pipeline        Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  fromStageId     String
  fromStage       Stage    @relation("TransitionFrom", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStageId       String
  toStage         Stage    @relation("TransitionTo", fields: [toStageId], references: [id], onDelete: Cascade)
  allowedRoles    String   @default("[]") // JSON array of role names, empty = all
  conditions      String   @default("{}") // JSON: {min_amount, max_amount, etc.}
  requireApproval Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([pipelineId, fromStageId, toStageId])
  @@index([pipelineId, fromStageId])
}

model DealStageHistory {
  id              String   @id @default(cuid())
  organizationId  String
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStageId     String?
  fromStage       Stage?   @relation("HistoryFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId       String?
  toStage         Stage?   @relation("HistoryTo", fields: [toStageId], references: [id], onDelete: SetNull)
  changedById     String
  changedAt       DateTime @default(now())
  reason          String?
  durationInPreviousStage Int @default(0) // seconds

  @@index([dealId, changedAt])
  @@index([organizationId, toStageId, changedAt])
}

// ===========================================================================
// Phase 9 — Blueprint Engine: enforce sales process compliance
// ===========================================================================

model Blueprint {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  pipelineId      String
  pipeline        Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  isActive        Boolean  @default(false)
  isPublished     Boolean  @default(false)
  description     String?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  states          BlueprintState[]
  transitions     BlueprintTransition[]
  executions      BlueprintExecution[]

  @@index([organizationId, pipelineId, isActive])
}

model BlueprintState {
  id              String   @id @default(cuid())
  organizationId  String
  blueprintId     String
  blueprint       Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  stageId         String
  stage           Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  stateType       String   @default("normal") // normal|transitional|terminal
  entryActions    String   @default("[]") // JSON array
  exitActions     String   @default("[]") // JSON array
  timeLimitHours  Int?
  createdAt       DateTime @default(now())

  transitionsFrom BlueprintTransition[] @relation("BPTransitionFrom")
  transitionsTo   BlueprintTransition[] @relation("BPTransitionTo")
  timers          BlueprintTimer[]
  timerTargets    BlueprintTimer[] @relation("BPTimerTarget")
  executions      BlueprintExecution[]

  @@unique([blueprintId, stageId])
  @@index([blueprintId])
}

model BlueprintTransition {
  id              String   @id @default(cuid())
  organizationId  String
  blueprintId     String
  blueprint       Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  fromStateId     String
  fromState       BlueprintState @relation("BPTransitionFrom", fields: [fromStateId], references: [id], onDelete: Cascade)
  toStateId       String
  toState         BlueprintState @relation("BPTransitionTo", fields: [toStateId], references: [id], onDelete: Cascade)
  allowedRoles    String   @default("[]") // JSON array
  conditions      String   @default("{}") // JSON field expressions
  requireFields   String   @default("[]") // JSON array of field names
  requireApproval Boolean  @default(false)
  postTransitionActions String @default("[]") // JSON array
  createdAt       DateTime @default(now())

  fieldRequirements BlueprintFieldRequirement[]
  assignments       BlueprintAssignment[]

  @@unique([blueprintId, fromStateId, toStateId])
  @@index([blueprintId, fromStateId])
}

model BlueprintFieldRequirement {
  id              String   @id @default(cuid())
  organizationId  String
  transitionId    String
  transition      BlueprintTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  fieldName       String
  condition       String   @default("not_empty") // not_empty|equals|not_equals|greater_than|less_than|in
  value           String?

  @@index([transitionId])
}

model BlueprintAssignment {
  id              String   @id @default(cuid())
  organizationId  String
  transitionId    String
  transition      BlueprintTransition @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  assignTo        String   // role|user|team|field_value
  assignValue     String

  @@index([transitionId])
}

model BlueprintTimer {
  id              String   @id @default(cuid())
  organizationId  String
  stateId         String
  state           BlueprintState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  hours           Int
  action          String   // auto_transition|notify|escalate
  targetStateId   String?
  targetState     BlueprintState? @relation("BPTimerTarget", fields: [targetStateId], references: [id], onDelete: SetNull)
  notifyRoles     String   @default("[]") // JSON array
  escalateTo      String?

  @@index([stateId])
}

model BlueprintExecution {
  id              String   @id @default(cuid())
  organizationId  String
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  blueprintId     String
  blueprint       Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  currentStateId  String?
  currentState    BlueprintState? @relation(fields: [currentStateId], references: [id], onDelete: SetNull)
  enteredStateAt  DateTime @default(now())
  history         String   @default("[]") // JSON array of transitions
  isComplete      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([dealId])
  @@index([organizationId, currentStateId])
  @@index([organizationId, isComplete])
}

// ===========================================================================
// Phase 10 — Rule Engine: Approvals, Validation, Assignment, Escalation
// ===========================================================================

model ApprovalProcess {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  targetModel     String   // deal|lead|contact|account|task|event
  triggerCriteria String   @default("{}") // JSON
  isActive        Boolean  @default(true)
  version         Int      @default(1)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps           ApprovalStep[]
  requests        ApprovalRequest[]

  @@index([organizationId, targetModel, isActive])
}

model ApprovalStep {
  id              String   @id @default(cuid())
  organizationId  String
  processId       String
  process         ApprovalProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  order           Int
  stepType        String   @default("sequential") // sequential|parallel|first_to_approve|majority_vote|unanimous
  approvers       String   @default("[]") // JSON array of {type, value}
  timeLimitHours  Int?
  escalationApprover String? // JSON
  requireComment  Boolean  @default(false)
  createdAt       DateTime @default(now())

  requests        ApprovalRequest[]

  @@index([processId, order])
}

model ApprovalRequest {
  id              String   @id @default(cuid())
  organizationId  String
  processId       String
  process         ApprovalProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  targetModule    String
  targetId        String
  targetName      String
  submittedById   String
  submittedAt     DateTime @default(now())
  currentStepId   String?
  currentStep     ApprovalStep? @relation(fields: [currentStepId], references: [id], onDelete: SetNull)
  status          String   @default("pending") // pending|approved|rejected|recalled|escalated
  completedAt     DateTime?
  comments        String   @default("[]") // JSON array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actions         ApprovalAction[]

  @@index([organizationId, status])
  @@index([organizationId, submittedById])
  @@index([organizationId, targetModule, targetId])
}

model ApprovalAction {
  id              String   @id @default(cuid())
  organizationId  String
  requestId       String
  request         ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverId      String
  action          String   // approve|reject|delegate|escalate
  comment         String?
  timestamp       DateTime @default(now())

  @@index([requestId, timestamp])
}

model ApprovalDelegation {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String
  delegateToId    String
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([organizationId, userId, isActive])
}

model ValidationRule {
  id              String   @id @default(cuid())
  organizationId  String
  targetModel     String
  fieldName       String
  conditionType   String   @default("required") // required|regex|range|custom|unique
  conditionValue  String   @default("{}") // JSON
  errorMessage    String
  errorSeverity   String   @default("error") // error|warning
  triggerOn       String   @default("both") // create|update|both
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId, targetModel, isActive])
}

model AssignmentRule {
  id              String   @id @default(cuid())
  organizationId  String
  targetModel     String
  criteria        String   @default("{}") // JSON — legacy flat {field:value} OR {rows:[{field,operator,value}],logic}
  strategy        String   @default("round_robin") // round_robin|lead_balance|territory|custom
  assignTo        String   @default("[]") // JSON array of user ids
  fallbackUserId  String?
  territoryField  String?
  isActive        Boolean  @default(true)
  // Enhancement columns (additive, safe defaults) — rule naming, ordering,
  // only-if-unassigned guard, notifications and usage stats.
  name            String?   // human rule name (legacy rules keep NULL → UI shows strategy)
  priority        Int?      // lower runs first (legacy rules keep NULL → after named priorities)
  logic           String?   // AND | OR between criteria rows (legacy flat map is always AND)
  onlyIfUnassigned Boolean  @default(false) // reassign only when owner is currently empty
  notifyEmail     Boolean   @default(false) // email the assigned CSM
  notifyInApp     Boolean   @default(false) // in-app notification for the assigned CSM
  assignToRole    String?   // role id — pool = active members holding that role
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  history         AssignmentHistory[]

  @@index([organizationId, targetModel, isActive])
}

model AssignmentHistory {
  id              String   @id @default(cuid())
  organizationId  String
  ruleId          String?
  rule            AssignmentRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  recordModule    String
  recordId        String
  assignedToId    String
  assignedAt      DateTime @default(now())

  @@index([organizationId, recordModule, recordId])
}

model EscalationRule {
  id              String   @id @default(cuid())
  organizationId  String
  targetModel     String
  criteria        String   @default("{}") // JSON
  timeLimitHours  Int
  escalateTo      String   @default("{}") // JSON {type, value}
  action          String   @default("notify") // reassign|notify|both
  isActive        Boolean  @default(true)
  // --- additive optional enrichment (rule-builder enhancement) ---
  conditions      String?  // JSON — trigger condition rows [{field, operator, value}]
  assigneeUserId  String?  // assign escalation to a specific user
  assigneeRoleId  String?  // …or to a role (mutually exclusive with assigneeUserId in the UI)
  priority        String?  // low|medium|high|urgent
  warnAfterHours  Int?     // "warn after X hours" threshold (≤ timeLimitHours)
  fallbackActions String?  // JSON — array of fallback action keys
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  logs            EscalationLog[]

  @@index([organizationId, targetModel, isActive])
}

model EscalationLog {
  id              String   @id @default(cuid())
  organizationId  String
  ruleId          String?
  rule            EscalationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  recordModule    String
  recordId        String
  escalatedToId   String?
  actionTaken     String
  createdAt       DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ===========================================================================
// Phase 11 — Workflow Engine: WorkflowRule, WorkflowAction, WorkflowExecution
// ===========================================================================

model WorkflowRule {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  triggerType     String
  triggerModel    String?
  triggerConditions String @default("{}")
  isActive        Boolean  @default(false)
  version         Int      @default(1)
  createdById     String
  lastRunAt       DateTime?
  runCount        Int      @default(0)
  errorCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actions         WorkflowAction[]
  executions      WorkflowExecution[]

  @@index([organizationId, isActive, triggerType, triggerModel])
}

model WorkflowAction {
  id              String   @id @default(cuid())
  organizationId  String
  ruleId          String
  rule            WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  order           Int
  actionType      String
  config          String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([ruleId, order])
}

model WorkflowExecution {
  id              String   @id @default(cuid())
  organizationId  String
  ruleId          String?
  rule            WorkflowRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  targetModule    String
  targetId        String
  status          String   @default("running")
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  errorMessage    String?
  actionsExecuted String   @default("[]")
  createdAt       DateTime @default(now())

  @@index([organizationId, ruleId, createdAt])
  @@index([organizationId, status])
}

model ScheduledJob {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  cronExpression  String
  actionType      String
  config          String   @default("{}")
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  status          String   @default("active")
  timezone        String   @default("UTC")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  logs            ScheduledJobLog[]

  @@index([organizationId, status, nextRunAt])
}

model ScheduledJobLog {
  id              String   @id @default(cuid())
  organizationId  String
  jobId           String?
  job             ScheduledJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  status          String   @default("running")
  errorMessage    String?

  @@index([jobId, startedAt])
}

// ===========================================================================
// Phase 12 — Custom Functions: Scripting engine
// ===========================================================================

model CustomFunction {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  language        String   @default("javascript") // python|javascript|visual
  triggerEvent    String   @default("manual") // manual|webhook|workflow|scheduled|api
  code            String   @default("")
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  isApproved      Boolean  @default(false)
  createdById     String
  lastExecutedAt  DateTime?
  executionCount  Int      @default(0)
  errorCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variables       CustomFunctionVariable[]
  executions      CustomFunctionExecution[]
  versions        CustomFunctionVersion[]

  @@index([organizationId, isActive, triggerEvent])
}

model CustomFunctionVariable {
  id              String   @id @default(cuid())
  organizationId  String
  functionId      String
  function        CustomFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  name            String
  varType         String   @default("input") // input|output
  dataType        String   @default("string") // string|number|boolean|json|record
  description     String?
  defaultValue    String?
  isRequired      Boolean  @default(false)

  @@index([functionId, varType])
}

model CustomFunctionExecution {
  id              String   @id @default(cuid())
  organizationId  String
  functionId      String?
  function        CustomFunction? @relation(fields: [functionId], references: [id], onDelete: SetNull)
  trigger         String   @default("manual") // workflow|manual|api|webhook|scheduled
  inputData       String   @default("{}") // JSON
  outputData      String?  // JSON
  status          String   @default("running") // running|completed|failed
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  errorMessage    String?
  logOutput       String   @default("")
  executionTimeMs Int     @default(0)
  createdAt       DateTime @default(now())

  @@index([organizationId, functionId, startedAt])
  @@index([organizationId, status])
}

model CustomFunctionVersion {
  id              String   @id @default(cuid())
  organizationId  String
  functionId      String
  function        CustomFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  version         Int
  code            String
  createdById     String
  createdAt       DateTime @default(now())

  @@unique([functionId, version])
  @@index([functionId, version])
}

model KVStore {
  id              String   @id @default(cuid())
  organizationId  String
  key             String
  value           String
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, key])
}

model HttpAllowlist {
