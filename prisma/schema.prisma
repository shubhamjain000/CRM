model CanvasTheme {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  // Defaults MUST mirror the app's native brand (navy sidebar "colored" look,
  // Geist font, medium radius) — the theme applier clears any value equal to
  // these, so a freshly auto-created row is a visual no-op. Misaligned defaults
  // here previously repainted the whole app blue with an invisible sidebar.
  primaryColor    String   @default("#223558")
  accentColor     String   @default("#3b82f6")
  fontFamily      String   @default("Geist")
  borderRadius    String   @default("medium")
  density         String   @default("comfortable")
  sidebarStyle    String   @default("colored")
  logoUrl         String?
  customCss       String?
  loginPageBg     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

