// ===========================================================================
// Phase 17 — Customization Engine
// ===========================================================================

model CustomModule {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  pluralName      String
  slug            String
  icon            String   @default("Box")
  color           String   @default("#3b82f6")
  recordNameField String   @default("name")
  isActive        Boolean  @default(true)
  isSystem        Boolean  @default(false)
  // Module builder enhancements (additive, safe JSON defaults)
  sectionsConfig  String   @default("{}")  // JSON: ordered sections [{name, columns: 1|2, collapsible}]
  viewsConfig     String   @default("[]")  // JSON: named custom views [{name, filters}]
  recordNameFormat String? // "field" (default) | "auto" — auto generates PREFIX-#### record names
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fields          CustomModuleField[]
  records         CustomModuleRecord[]
  parentRelations CustomModuleRelation[] @relation("CustomModuleParent")
  childRelations  CustomModuleRelation[] @relation("CustomModuleChild")

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
}

// Related lists — link two custom modules so child records surface on the
// parent record's detail view. one_to_many stores the parent record id in the
// child's data[childFieldApiName]; many_to_many stores an array of parent ids.
model CustomModuleRelation {
  id                String   @id @default(cuid())
  organizationId    String
  parentModuleId    String
  parentModule      CustomModule @relation("CustomModuleParent", fields: [parentModuleId], references: [id], onDelete: Cascade)
  childModuleId     String
  childModule       CustomModule @relation("CustomModuleChild", fields: [childModuleId], references: [id], onDelete: Cascade)
  name              String
  childFieldApiName String
  type              String   @default("one_to_many") // one_to_many | many_to_many
  createdAt         DateTime @default(now())

  @@index([organizationId, parentModuleId])
  @@index([childModuleId])
}

model CustomModuleField {
  id              String   @id @default(cuid())
  organizationId  String
  moduleId        String
  module          CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  label           String
  apiName         String
  fieldType       String   @default("text")
  fieldOptions    String   @default("{}")
  defaultValue    String?
  isRequired      Boolean  @default(false)
  isUnique        Boolean  @default(false)
  isSearchable    Boolean  @default(true)
  displayOrder    Int      @default(0)
  section         String?
  // Field property enhancements (additive, safe defaults)
  helpText        String?   // tooltip / help text shown in the record form
  isReadOnly      Boolean   @default(false)
  dependency      String?   // JSON {field, value} — show this field only when dependency matches
  createdAt       DateTime @default(now())

  @@unique([moduleId, apiName])
  @@index([moduleId, displayOrder])
}

model CustomModuleRecord {
  id              String   @id @default(cuid())
  organizationId  String
  moduleId        String
  module          CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  data            String   @default("{}")
  createdById     String? // additive: auto-tracked user, nullable
  modifiedById    String? // additive: auto-tracked user, nullable
