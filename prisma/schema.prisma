// ---------------------------------------------------------------------------
// Inventory / CPQ suite (Zoho CRM parity): Products, Price Books, Vendors,
// Quotes, Sales Orders, Purchase Orders. Line items are stored as JSON string
// columns (same convention as phones/addresses): [{ productId, name, qty,
// rate, discountPct, taxPct, total }]; totals are recomputed server-side on
// every write so clients can never persist inflated numbers.
// ---------------------------------------------------------------------------

model Product {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  productCode     String?
  category        String?
  unit            String?  // e.g. Each, Box, Hour, License
  unitPrice       Float    @default(0)
  taxPercent      Float    @default(0)
  active          Boolean  @default(true)
  description     String?
  ownerId         String
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  priceBookEntries PriceBookEntry[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, active])
}

model PriceBook {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  active          Boolean  @default(true)
  ownerId         String
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation("PriceBookOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  entries         PriceBookEntry[]

  @@index([organizationId, deletedAt])
}

model PriceBookEntry {
  id              String   @id @default(cuid())
  organizationId  String
  priceBookId     String
  priceBook       PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price           Float
  createdAt       DateTime @default(now())

  @@unique([priceBookId, productId])
  @@index([organizationId])
}

model Vendor {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  category        String?  // supplier|manufacturer|distributor|service|other
  emails          String   @default("[]")
  phones          String   @default("[]")
  website         String?
  address         String   @default("{}")
  description     String?
  ownerId         String
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation("VendorOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  purchaseOrders  PurchaseOrder[]

  @@index([organizationId, deletedAt])
}

model Quote {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  accountId       String?
  contactId       String?
  dealId          String?
  status          String   @default("draft") // draft|sent|accepted|declined|expired
  validUntil      DateTime?
  items           String   @default("[]")
  subtotal        Float    @default(0)
  discountTotal   Float    @default(0)
  taxTotal        Float    @default(0)
  grandTotal      Float    @default(0)
  currency        String   @default("INR")
  terms           String?
  description     String?
  ownerId         String
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation("QuoteOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
}

model SalesOrder {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  accountId       String?
  contactId       String?
  dealId          String?
  status          String   @default("draft") // draft|confirmed|delivered|cancelled
  items           String   @default("[]")
  subtotal        Float    @default(0)
  discountTotal   Float    @default(0)
  taxTotal        Float    @default(0)
  grandTotal      Float    @default(0)
  currency        String   @default("INR")
  terms           String?
  description     String?
  ownerId         String
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation("SalesOrderOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  vendorId        String?
  vendor          Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  status          String   @default("draft") // draft|issued|received|cancelled
  items           String   @default("[]")
  subtotal        Float    @default(0)
  discountTotal   Float    @default(0)
  taxTotal        Float    @default(0)
  grandTotal      Float    @default(0)
  currency        String   @default("INR")
  terms           String?
  description     String?
  ownerId         String
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation("PurchaseOrderOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
}

// --- Record tags (Zoho-style colored tags on leads/contacts/accounts/deals) -

model Tag {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  color           String   @default("slate")
  createdAt       DateTime @default(now())

  links           TagLink[]

  @@unique([organizationId, name])
}

model TagLink {
  id              String   @id @default(cuid())
  organizationId  String
  tagId           String
  tag             Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  module          String   // lead|contact|account|deal
  recordId        String
  createdAt       DateTime @default(now())

  @@unique([tagId, module, recordId])
  @@index([organizationId, module, recordId])
}
